# Database Configuration
DATABASE_URL=postgresql://keepshot:keepshot_dev_password@db:5432/keepshot

# LLM Provider — "openai" or "claude"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# OpenAI (if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic / Claude (if LLM_PROVIDER=claude)
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# LLM_MODEL=claude-haiku-4-5-20251001

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Monitoring Configuration
DEFAULT_CHECK_INTERVAL=60  # minutes
MAX_CONCURRENT_CHECKS=10

# Storage Configuration
STORAGE_PATH=/app/storage
MAX_FILE_SIZE=100  # MB

# JWT Authentication (required for /api/v1/auth endpoints)
JWT_SECRET=change-me-to-a-long-random-secret
# JWT_ALGORITHM=HS256
# JWT_EXPIRATION=86400  # seconds (24 hours)

# CORS — comma-separated list of allowed origins
# ALLOWED_ORIGINS=https://keepshot.xyz,https://app.keepshot.xyz

# Optional: Webhook Notifications
# WEBHOOK_URL=https://your-service.com/webhook
# WEBHOOK_SECRET=your-webhook-secret

# Optional: Rate Limiting
# RATE_LIMIT_PER_MINUTE=60
# RATE_LIMIT_PER_HOUR=1000
